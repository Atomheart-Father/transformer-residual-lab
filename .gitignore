.venv/
__pycache__/
*.pyc
.DS_Store
.hf_cache/
.cache/

# dataset token windows stay local; only hashes and rules are committed
data/*
data257/*
# manifests are small, text-free, and are the provenance record
!data/data_manifest.json
!data257/data_manifest.json
!data257/fresh_test_manifest.json
!data257/test_v2_manifest.json
!data257/ood_imdb_manifest.json

# local agent workspace (notes, memory) stays local
.workbuddy-ai/

# scratch runs, not part of the reported evidence
results/devcheck/
results/probe_win/
results/scratch/

# model weights and large binaries are never committed
*.safetensors
*.gguf
*.mlx
*.log

# large derived tensors stay local; regenerate with scripts/compensate.py
# and scripts/serial_compensate.py (collect stage). A.npy / C.npy are
# [n_samples, n_sites, seq_len, hidden] float32 — ~250 MB each at 64 windows.
**/pairs.npz
**/seq_pairs.npz
**/A.npy
**/C.npy
**/*_activations.npz

# Stage 1.8 teacher-slice caches: ~1 GB per split on disk. Regenerate with
# `scripts/tiny_serial.py --stage collect`. manifests are text and are kept.
# `cl` (no suffix) is the smoke-test dir name, so both patterns are needed.
**/cl_*/
**/cl/
!**/cl_*/collect_manifest.json
!**/cl/collect_manifest.json

# scratch runs, not part of the reported evidence
results/smoke_18/

# short-budget probes: the fit_*.json summary is the record, the weights are scratch
**/fit/*_short.npz

# local scratch (test temp roots, throwaway logs). The kaggle test suite pins
# tempfile.tempdir here because some sandboxes refuse to probe /tmp.
.tmpwork/
research/kaggle/.trlab_tmp/

# trlab run dir when invoked from the source tree (python -m trlab)
research/kaggle/_trlab_run/

.venv/
__pycache__/
*.pyc
.DS_Store
.hf_cache/
.cache/

# dataset token windows stay local; only hashes and rules are committed
data/*
data257/*
# manifests are small, text-free, and are the provenance record
!data/data_manifest.json
!data257/data_manifest.json
!data257/fresh_test_manifest.json

# local agent workspace (notes, memory) stays local
.workbuddy-ai/

# scratch runs, not part of the reported evidence
results/devcheck/
results/probe_win/
results/scratch/

# model weights and large binaries are never committed
*.safetensors
*.gguf
*.mlx
*.log

# large derived tensors stay local; regenerate with scripts/compensate.py
**/pairs.npz
